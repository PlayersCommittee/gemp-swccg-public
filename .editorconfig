root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
tab_width = 4

[*.xml]
indent_size = 4
tab_width = 4

[*.properties]
indent_size = 4
tab_width = 4

[*.json]
indent_size = 2
tab_width = 2

[*.yml]
indent_size = 2
tab_width = 2

[*.yaml]
indent_size = 2
tab_width = 2
